[gd_scene format=3]

[node name="MonthlyReport" type="PanelContainer"]
custom_minimum_size = Vector2(0, 192)

[node name="Columns" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Report" type="VBoxContainer" parent="Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Heading" type="Label" parent="Columns/Report"]
layout_mode = 2
theme_type_variation = &"Section"
text = "MONTHLY GOVERNING REPORT"

[node name="Scroll" type="ScrollContainer" parent="Columns/Report"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ReportText" type="Label" parent="Columns/Report/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
text = "No monthly report yet."
autowrap_mode = 3

[node name="DispatchColumn" type="VBoxContainer" parent="Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Heading" type="Label" parent="Columns/DispatchColumn"]
layout_mode = 2
theme_type_variation = &"Section"
text = "FROM THE WIRE / DISPATCHES"

[node name="Scroll" type="ScrollContainer" parent="Columns/DispatchColumn"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="DispatchText" type="Label" parent="Columns/DispatchColumn/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Muted"
text = "No dispatches yet."
autowrap_mode = 3
