[gd_scene format=3]

[node name="SituationPanel" type="PanelContainer"]
visible = false
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Heading" type="Label" parent="Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Title"
text = "SITUATION"

[node name="CloseSituationButton" type="Button" parent="Content/Header"]
custom_minimum_size = Vector2(96, 44)
layout_mode = 2
text = "Close"

[node name="SituationMeta" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"Muted"
text = ""
autowrap_mode = 3

[node name="Rule" type="HSeparator" parent="Content"]
layout_mode = 2

[node name="SituationScroll" type="ScrollContainer" parent="Content"]
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="SituationBody" type="VBoxContainer" parent="Content/SituationScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="SituationTitle" type="Label" parent="Content/SituationScroll/SituationBody"]
layout_mode = 2
theme_type_variation = &"Section"
text = "No situation selected"
autowrap_mode = 3

[node name="SituationDescription" type="Label" parent="Content/SituationScroll/SituationBody"]
layout_mode = 2
size_flags_horizontal = 3
text = ""
autowrap_mode = 3

[node name="Options" type="VBoxContainer" parent="Content/SituationScroll/SituationBody"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="SituationStatus" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"Muted"
text = ""
autowrap_mode = 3
