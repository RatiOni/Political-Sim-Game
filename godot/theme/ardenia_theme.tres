; Ardenia dashboard theme — mission-control terminal.
;
; Target: Third Bloc's control-room screens (see memory
; visual-reference-third-bloc). Near-black glass, thin grey frame lines with
; the panel title cut into the top line (drawn by `TerminalFrame`), one
; monospace face in caps, dim keys beside cream values, amber for state and
; red only for alarm. Colours mirror `scripts/ui/ui_palette.gd`; change one,
; change the other.
[gd_resource type="Theme" load_steps=14 format=3]

[sub_resource type="SystemFont" id="Mono"]
font_names = PackedStringArray("Consolas", "Lucida Console", "Courier New", "Monospace")
antialiasing = 1
hinting = 2

[sub_resource type="StyleBoxFlat" id="Background"]
bg_color = Color(0.043, 0.051, 0.043, 1)

[sub_resource type="StyleBoxFlat" id="Panel"]
content_margin_left = 16.0
content_margin_top = 16.0
content_margin_right = 16.0
content_margin_bottom = 12.0
bg_color = Color(0.051, 0.059, 0.051, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.39, 0.40, 0.37, 1)

[sub_resource type="StyleBoxFlat" id="Button"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(0.051, 0.059, 0.051, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.30, 0.31, 0.29, 1)

[sub_resource type="StyleBoxFlat" id="Hover"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(0.09, 0.10, 0.09, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.89, 0.60, 0.23, 1)

; Selected / toggled-on: amber fill, dark ink — the chosen speed has to read
; as lit from across the room, not as a slightly different grey.
[sub_resource type="StyleBoxFlat" id="Pressed"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(0.89, 0.60, 0.23, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.96, 0.78, 0.45, 1)

[sub_resource type="StyleBoxFlat" id="Disabled"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(0.043, 0.051, 0.043, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.18, 0.19, 0.17, 1)

[sub_resource type="StyleBoxFlat" id="Focus"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.96, 0.78, 0.45, 1)
expand_margin_left = 2.0
expand_margin_top = 2.0
expand_margin_right = 2.0
expand_margin_bottom = 2.0

[sub_resource type="StyleBoxLine" id="Rule"]
color = Color(0.24, 0.25, 0.23, 1)
thickness = 1

[sub_resource type="StyleBoxFlat" id="Track"]
bg_color = Color(0.043, 0.051, 0.043, 1)
content_margin_left = 2.0
content_margin_top = 2.0
content_margin_right = 2.0
content_margin_bottom = 2.0

; The title-screen plate: a terminal window over the scene. Opaque, so the
; backdrop never muddies the type.
[sub_resource type="StyleBoxFlat" id="Plate"]
content_margin_left = 40.0
content_margin_top = 32.0
content_margin_right = 40.0
content_margin_bottom = 28.0
bg_color = Color(0.043, 0.051, 0.043, 0.96)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.39, 0.40, 0.37, 1)

[sub_resource type="StyleBoxFlat" id="Grabber"]
bg_color = Color(0.30, 0.31, 0.29, 1)

[sub_resource type="StyleBoxFlat" id="GrabberLit"]
bg_color = Color(0.89, 0.60, 0.23, 1)

[resource]
default_font = SubResource("Mono")
default_font_size = 15
