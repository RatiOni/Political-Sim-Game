; Ardenia dashboard theme — retro DOS pixel.
;
; The map is 8 px VGA pixel art, so the chrome is too: pixel fonts, flat
; fills, hard 1 px borders, zero corner radius, spacing on an 8 px grid.
; Colours here mirror `scripts/ui/ui_palette.gd`, which sources them from
; `MapPalette.DAY`. Change one, change the other, or the UI and the map
; drift apart again.
[gd_resource type="Theme" load_steps=14 format=3]

[ext_resource type="FontFile" path="res://assets/pixel/kenney_mini.ttf" id="BodyFont"]
[ext_resource type="FontFile" path="res://assets/pixel/kenney_pixel.ttf" id="DisplayFont"]

[sub_resource type="StyleBoxFlat" id="Background"]
bg_color = Color(0.031, 0.031, 0.063, 1)

