[gd_resource type="Theme" load_steps=10 format=3]

[sub_resource type="SystemFont" id="BodyFont"]
font_names = PackedStringArray("Segoe UI", "Arial")

[sub_resource type="SystemFont" id="MastheadFont"]
font_names = PackedStringArray("Georgia", "Times New Roman")
font_weight = 700

[sub_resource type="StyleBoxFlat" id="Background"]
bg_color = Color(0.075, 0.09, 0.088, 1)

